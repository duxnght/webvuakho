# ==============================================================================
# FILE MẪU — Sao chép thành .env rồi điền thông tin thực
# Chạy lệnh: copy .env.example .env
# ==============================================================================

SECRET_KEY=your-secret-key-here

# Database MySQL (production / cPanel)
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Cloudinary — lấy tại: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Deploy webhook secret — dùng: python -c "import secrets; print(secrets.token_hex(32))"
DEPLOY_WEBHOOK_TOKEN=your-deploy-token-here
